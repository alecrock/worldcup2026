.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-section {
  text-align: center;
  margin-top: 100rpx;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.like-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.like-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s;
  margin-bottom: 30rpx;
}

.like-btn.liked {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.like-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.like-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: bold;
}

.liked .like-text {
  color: white;
}

.like-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.features {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 60rpx;
  animation: fadeIn 0.5s;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  width: 180rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.feature-name {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
}

.stats {
  display: flex;
  justify-content: space-around;
  width: 100%;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  animation: fadeIn 0.5s;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}
