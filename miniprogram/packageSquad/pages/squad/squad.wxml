<!--pages/squad/squad.wxml-->
<view class="container">
  <view class="header">
    <view class="header-title">🏆 2026世界杯</view>
    <view class="header-sub">球队阵容</view>
  </view>

  <!-- 球队筛选按钮 -->
  <scroll-view class="team-filter" scroll-x>
    <view
      wx:for="{{teamList}}"
      wx:key="*this"
      class="team-btn {{activeTeam === item ? 'active' : ''}}"
      bindtap="onTeamTap"
      data-team="{{item}}"
    >{{item}}</view>
  </scroll-view>

  <!-- 阵容详情 -->
  <scroll-view class="squad-content" scroll-y wx:if="{{currentSquad}}">
    <view class="squad-card">
      <view class="squad-header">
        <view class="squad-name">{{currentSquad.group}} {{activeTeam}}</view>
        <view class="squad-coach">教练：{{currentSquad.coach}}</view>
        <view wx:if="{{currentSquad.note}}" class="squad-note">{{currentSquad.note}}</view>
      </view>

      <block wx:for="{{positionLabels}}" wx:key="pos">
        <view class="pos-section" wx:if="{{currentSquad.players[item.pos] && currentSquad.players[item.pos].length > 0}}">
          <view class="pos-title">{{item.label}}</view>
          <view class="players-grid">
            <view wx:for="{{currentSquad.players[item.pos]}}" wx:for-item="player" wx:key="name" class="player-item" bindtap="onPlayerTap" data-name="{{player.name}}" data-club="{{player.club}}">
              <view class="player-name {{player.captain ? 'captain' : ''}} {{player.injured ? 'injured' : ''}}">
                {{player.name}}
                <text wx:if="{{player.captain}}" class="badge-captain">队长</text>
                <text wx:if="{{player.injured}}" class="badge-injured">伤停</text>
              </view>
              <view class="player-club">{{player.club}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{!currentSquad}}" class="empty-tip">请选择一支球队查看阵容</view>

  <!-- 球员详情弹窗 -->
  <view class="player-modal-overlay {{showPlayerModal ? 'active' : ''}}" bindtap="closePlayerModal">
    <view class="player-modal" catchtap="preventBubble">
      <view class="player-modal-close" bindtap="closePlayerModal">✕</view>
      <view class="player-modal-header">
        <view class="player-modal-avatar" wx:if="{{!playerModalAvatar}}">{{playerModalName[0]}}</view>
        <image class="player-modal-avatar-img" wx:if="{{playerModalAvatar}}" src="{{playerModalAvatar}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view class="player-modal-info">
          <view class="player-modal-name">{{playerModalName}}</view>
          <view class="player-modal-club">{{playerModalClub}}</view>
        </view>
      </view>
      <view class="player-modal-body">
        <view class="player-modal-section-title">近期比赛</view>
        <view wx:if="{{playerModalLoading}}" class="player-modal-loading">⏳ 加载中...</view>
        <view wx:elif="{{playerModalMatches.length === 0}}" class="player-modal-error">暂无近期比赛数据</view>
        <view wx:for="{{playerModalMatches}}" wx:key="index" class="player-modal-match">
          <view class="player-modal-match-date">{{item.date}}</view>
          <view class="player-modal-match-fixtures">
            <text class="match-type-tag {{item.leagueCss}}">{{item.league}}</text>
            {{item.home}}
            <text class="player-modal-match-score">{{item.score}}</text>
            {{item.away}}
          </view>
          <view class="player-modal-match-weather" wx:if="{{item.weather}}">
            🌡️ {{item.weather.text}}
          </view>
          <view class="player-modal-match-stats">
            ⚽{{item.goals || 0}} 🅰️{{item.assists || 0}}
            <text wx:if="{{item.rating}}"> ⭐{{item.rating}}</text>
            <text wx:if="{{item.minutes > 0}}"> {{item.minutes}}分钟</text>
            <text wx:if="{{item.minutes === 0}}"> 未出场</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
