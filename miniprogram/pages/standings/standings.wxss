/* pages/standings/standings.wxss */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f8f9fa;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
}

.header-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 子标签切换 */
.sub-tab-container {
  display: flex;
  background: #f0f3ff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.sub-tab {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-weight: bold;
  color: #666;
  font-size: 28rpx;
}

.sub-tab.active {
  background: #667eea;
  color: white;
}

/* 小组筛选 */
.group-filter {
  display: flex;
  background: white;
  padding: 20rpx;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
}

.group-btn {
  padding: 12rpx 24rpx;
  border: 2rpx solid #667eea;
  background: white;
  color: #667eea;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: inline-block;
  flex-shrink: 0;
}

.group-btn.active {
  background: #667eea;
  color: white;
}

/* 积分榜 */
.standings-list {
  padding: 0 20rpx 20rpx;
}

.standing-group {
  margin-bottom: 40rpx;
}

.standing-group-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 20rpx;
  padding: 16rpx 24rpx;
  background: white;
  border-radius: 12rpx;
}

.standing-table {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.standing-header {
  display: flex;
  background: #667eea;
  color: white;
  font-size: 22rpx;
  font-weight: bold;
  padding: 16rpx 8rpx;
}

.standing-header text {
  flex: 1;
  text-align: center;
}

.standing-row {
  display: flex;
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 24rpx;
  align-items: center;
}

.standing-row.qualified {
  background: #e8f5e9;
}

.standing-pos {
  width: 50rpx;
  text-align: center;
  font-weight: bold;
  color: #667eea;
}

.standing-team {
  flex: 2;
  text-align: left;
  font-weight: 500;
  padding-left: 8rpx;
}

.standing-p, .standing-w, .standing-d, .standing-l, .standing-gf, .standing-ga, .standing-gd, .standing-pts {
  flex: 1;
  text-align: center;
}

.standing-pts {
  font-weight: bold;
  color: #667eea;
}

/* 射手榜 */
.scorer-container {
  padding: 20rpx;
}

.scorer-table {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  margin-bottom: 20rpx;
}

.scorer-header {
  display: flex;
  background: #764ba2;
  color: white;
  font-size: 26rpx;
  font-weight: bold;
  padding: 20rpx 16rpx;
}

.scorer-header text {
  text-align: center;
}

.scorer-rank {
  width: 80rpx;
  text-align: center;
}

.scorer-name-header {
  flex: 2;
  text-align: left;
  padding-left: 16rpx;
}

.scorer-team-header {
  flex: 1.5;
  text-align: center;
}

.scorer-goals-header {
  width: 100rpx;
  text-align: center;
}

.scorer-row {
  display: flex;
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 26rpx;
  align-items: center;
}

.scorer-row:nth-child(even) {
  background: #f8f9fa;
}

.scorer-rank {
  width: 80rpx;
  text-align: center;
  font-weight: bold;
  color: #764ba2;
}

.scorer-name {
  flex: 2;
  text-align: left;
  font-weight: 500;
  padding-left: 16rpx;
}

.scorer-team {
  flex: 1.5;
  text-align: center;
  color: #666;
}

.scorer-goals {
  width: 100rpx;
  text-align: center;
  font-weight: bold;
  color: #764ba2;
  font-size: 30rpx;
}

.scorer-note {
  display: block;
  text-align: center;
  color: #999;
  font-size: 22rpx;
  margin-top: 20rpx;
}
