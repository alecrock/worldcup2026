/* app.wxss - 全局样式 */
page {
  background: #1e3c72;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  color: #333;
}

.container {
  max-width: 414px;
  margin: 0 auto;
  background: white;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 20rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
